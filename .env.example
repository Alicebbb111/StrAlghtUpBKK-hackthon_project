# Optional. Start with: node --env-file=.env backend/server.js
PORT=3000
HOST=127.0.0.1
# Set to 1 only behind an HTTPS reverse proxy.
COOKIE_SECURE=0
# Optional directory for the SQLite database; defaults to ./data
# DATA_DIR=./data
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Global request cap per UTC day, including failed attempts
AI_DAILY_LIMIT=20
